# Copy to .env for `pnpm dev` on the host.
# Docker Compose reads POSTGRES_* from this file and gives the app
# a DATABASE_URL that uses the hostname `db` instead of localhost.

POSTGRES_USER=canteen
POSTGRES_PASSWORD=canteen
POSTGRES_DB=canteen
POSTGRES_PORT=5432
APP_PORT=3000

DATABASE_URL=postgresql://canteen:canteen@localhost:5432/canteen

AUTH_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
SENDGRID_API_KEY=
CRON_SECRET=
